#version 450
#extension GL_ARB_separate_shader_objects : enable

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

// TODO: Add bindings to:
// 1. Store the input blades
// 2. Write out the culled blades
// 3. Write the total number of blades remaining

// The project is using vkCmdDrawIndirect to use a buffer as the arguments for a draw call
// This is sort of an advanced feature so we've showed you what this buffer should look like
//
// layout(set = ???, binding = ???) buffer NumBlades {
// 	  uint vertexCount;   // Write the number of blades remaining here
// 	  uint instanceCount; // = 1
// 	  uint firstVertex;   // = 0
// 	  uint firstInstance; // = 0
// } numBlades;


layout(set = 2, binding = 0, std430) buffer AllBlades {
    Blade blades[];
};

layout(set = 2, binding = 1, std430) buffer CulledBlades {
    Blade culledBlades[];
};

layout(set = 2, binding = 2, std430) buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

#define GRAVITY 9.8
#define WIND_STRENGTH 6.0

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

void main() {
	// vertexCount is zeroed by vkCmdFillBuffer before this dispatch
	uint index = gl_GlobalInvocationID.x;
	if (index >= blades.length()) {
		return;
	}

	Blade blade = blades[index];
	vec3 v0 = blade.v0.xyz;
	vec3 v1 = blade.v1.xyz;
	vec3 v2 = blade.v2.xyz;
	vec3 up = blade.up.xyz;
	float orientation = blade.v0.w;
	float height = blade.v1.w;
	float stiffness = blade.up.w;

	// prevent overshooting at high dt
	float dt = min(deltaTime, 0.05);

	// forces
	vec3 t1 = vec3(cos(orientation), 0.0, sin(orientation));
	vec3 front = normalize(cross(t1, up));
	vec3 gravity = vec3(0.0, -GRAVITY, 0.0) + 0.25 * GRAVITY * front;

	vec3 recovery = (v0 + up * height - v2) * stiffness;

	vec3 windDirection = normalize(vec3(1.0, 0.0, 0.3));
	float windStrength = WIND_STRENGTH * (0.6 + 0.4 * sin(2.0 * totalTime + dot(v0.xz, vec2(0.4, 0.15))));
	float directionalAlignment = 1.0 - abs(dot(windDirection, normalize(v2 - v0)));
	float heightRatio = dot(v2 - v0, up) / height;
	vec3 wind = windDirection * windStrength * directionalAlignment * heightRatio;

	v2 += (gravity + recovery + wind) * dt;

	// state validation
	v2 -= up * min(dot(up, v2 - v0), 0.0);

	float lproj = length(v2 - v0 - up * dot(v2 - v0, up));
	v1 = v0 + height * up * max(1.0 - lproj / height, 0.05 * max(lproj / height, 1.0));

	// degree-2 curve length estimate
	float L0 = distance(v2, v0);
	float L1 = distance(v2, v1) + distance(v1, v0);
	float r = height / ((2.0 * L0 + L1) / 3.0);
	vec3 v1Corrected = v0 + r * (v1 - v0);
	v2 = v1Corrected + r * (v2 - v1);
	v1 = v1Corrected;

	blade.v1.xyz = v1;
	blade.v2.xyz = v2;
	blades[index] = blade;

	// TODO: Cull blades that are too far away or not in the camera frustum and write them
	// to the culled blades buffer
	// Note: to do this, you will need to use an atomic operation to read and update numBlades.vertexCount
	// You want to write the visible blades to the buffer without write conflicts between threads
	// placeholder until culling: keep every blade
	culledBlades[atomicAdd(numBlades.vertexCount, 1)] = blade;
}
